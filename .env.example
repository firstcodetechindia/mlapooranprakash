# Copy this file to .env for local development, or configure these as
# environment variables in your hosting provider (e.g. Vercel) for
# staging/production. Never commit a real .env file.

# ---------------------------------------------------------------------------
# Database (PostgreSQL via Prisma, @prisma/adapter-pg — no separate pooled
# vs. direct URL split; point this at any standard Postgres connection
# string, including a pooled one from a managed provider).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/political_command_center?schema=public"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Required in production (e.g. https://app.yourdomain.com). Leave unset in
# local dev — trustHost lets Auth.js infer the origin from the request,
# which matters since the dev server's port can shift.
AUTH_URL=""

# ---------------------------------------------------------------------------
# Object storage (S3-compatible). Falls back to local disk (.data/uploads)
# when unset — fine for local dev, but a hard requirement in any serverless
# deployment (Vercel's filesystem is ephemeral and not shared across
# invocations, so local-disk uploads silently vanish). See docs/deployment.md.
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="auto"

# ---------------------------------------------------------------------------
# AI provider. The app talks to an internal AIProvider interface — these
# credentials are only ever read server-side. Unset = MockAIProvider
# (deterministic, no external calls) via getAIProvider() in src/lib/ai.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Social platform apps. Only used by the official-API adapters in
# src/lib/social; never used for scraping or unofficial access. Connecting
# an account in Settings → Integrations currently takes an access token you
# obtain from each platform's own developer console (X Developer Portal /
# Meta for Developers) rather than a full in-app OAuth redirect — that's
# the natural next step once the app has a stable public callback URL to
# register with each platform. These IDs/secrets are reserved for that.
# ---------------------------------------------------------------------------
X_CLIENT_ID=""
X_CLIENT_SECRET=""
META_APP_ID=""
META_APP_SECRET=""

# Encrypts stored access tokens for connected social accounts at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Authenticates Vercel Cron's calls to /api/cron/publish-scheduled and
# /api/cron/refresh-analytics so neither can be triggered by anyone who
# finds the URL — both routes fail closed (401) if this is unset, they
# never fall back to "open." Generate with: openssl rand -base64 32
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Billing (Stripe). Leave all three unset for local dev — billing then runs
# in mock mode: "Upgrade to Pro" instantly flips the org's plan in the
# database with a full audit trail, no real subscription created. Set all
# three to enable real Checkout/webhooks/Billing Portal.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price ID for the Pro plan's recurring price, created in the Stripe Dashboard.
STRIPE_PRICE_ID_PRO=""

# ---------------------------------------------------------------------------
# Development / testing switches
# ---------------------------------------------------------------------------
# When "true", social provider adapters return realistic mock responses
# instead of calling real platform APIs — lets the whole app run locally
# without any social API credentials. See /src/lib/social.
MOCK_SOCIAL_APIS="true"
