// Political Social Command Center — database schema.
//
// This file grows incrementally with each build phase (see /docs/architecture.md).
// Phase 1 ships only the foundation needed for authentication, multi-tenant
// organizations, and role-based access control. Every later model added in
// subsequent phases must include an organizationId (or a path to one) so
// tenant isolation can be enforced consistently — see /src/lib/security.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Roles are intentionally global (not per-organization) so authorization
/// checks throughout the app can pattern-match on a small, fixed set.
enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  APPROVER
  ANALYST
  VIEWER
}

/// Self-serve tiers. ENTERPRISE is sales-assisted (no Stripe Checkout price
/// attached) — see /src/lib/billing/plans.ts for what each tier unlocks.
enum SubscriptionPlan {
  TRIAL
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

/// Default voice the AI content agent writes in unless a specific draft
/// overrides it (e.g. a CONDOLENCE post written while the org's default
/// tone is CONVERSATIONAL).
enum Tone {
  FORMAL
  WARM
  PUBLIC_SERVICE
  CONVERSATIONAL
  CELEBRATORY
  CONDOLENCE
  INFORMATIONAL
}

enum ContentLanguage {
  HINDI
  ENGLISH
  HINGLISH
}

/// A tenant. Every politician/comms-team account is scoped to one
/// Organization. No query anywhere in the app should read across
/// organizationId boundaries — see requireOrganizationAccess() in
/// /src/lib/security/authorize.ts.
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Every org starts on a 14-day TRIAL, no card required.
  plan                 SubscriptionPlan   @default(TRIAL)
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  memberships         Membership[]
  auditLogs           AuditLog[]
  politicianProfile   PoliticianProfile?
  referenceSources    ReferenceSource[]
  referencePosts      ReferencePost[]
  knowledgeDocuments  KnowledgeDocument[]
  knowledgeChunks     KnowledgeChunk[]
  contentOpportunities ContentOpportunity[]
  researchReports     ResearchReport[]
  drafts              Draft[]
  draftRevisions      DraftRevision[]
  factChecks          FactCheck[]
  mediaAssets         MediaAsset[]
  socialAccounts      SocialAccount[]
  socialPosts         SocialPost[]

  @@index([slug])
  @@index([stripeCustomerId])
}

/// An authenticated person. A User can belong to more than one Organization
/// (e.g. an agency staffer working multiple accounts), with a distinct Role
/// per Organization via Membership.
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Null when the user has never set a password (e.g. invited but not yet activated).
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships         Membership[]
  auditLogs           AuditLog[]
  uploadedDocuments   KnowledgeDocument[]
  researchReports     ResearchReport[]
  draftsCreated       Draft[]         @relation("DraftCreatedBy")
  draftsApproved      Draft[]         @relation("DraftApprovedBy")
  draftsRejected      Draft[]         @relation("DraftRejectedBy")
  draftRevisions      DraftRevision[]
  mediaAssets         MediaAsset[]
  connectedSocialAccounts SocialAccount[]

  @@index([email])
}

/// Join model carrying the user's Role within one Organization.
model Membership {
  id             String    @id @default(uuid())
  userId         String
  organizationId String
  role           Role      @default(VIEWER)
  invitedAt      DateTime  @default(now())
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

/// Immutable append-only trail of every sensitive action taken in the app.
/// Nothing in the normal application UI issues UPDATE or DELETE against this
/// table — see /src/lib/audit/log.ts, the only writer.
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  resourceType   String
  resourceId     String?
  previousState  Json?
  newState       Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

/// The constituency/district a politician represents. Kept separate from
/// PoliticianProfile (rather than inlined) because it carries its own
/// structured facts — population, key issues — that content generation
/// reads independently of the politician's personal voice/style fields.
model Constituency {
  id          String   @id @default(uuid())
  name        String
  state       String?
  country     String   @default("India")
  description String?
  population  Int?
  keyIssues   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  politicianProfile PoliticianProfile?
}

/// One per Organization — the politician's identity, voice, and knowledge
/// the AI content/research agents draw on. Every array field here is a
/// plain string list rather than a related table: they're short,
/// unstructured, and edited as a set (add/remove a phrase), which a
/// Postgres text array fits better than a join table would for Phase 2.
/// Full source documents (speeches, fact sheets) belong in the Knowledge
/// Base (KnowledgeDocument), not here.
model PoliticianProfile {
  id                String  @id @default(uuid())
  organizationId    String  @unique
  name              String
  publicDesignation String?
  politicalParty    String?
  bio               String?
  officialWebsite   String?
  xHandle           String?
  facebookHandle    String?
  instagramHandle   String?

  preferredTone      Tone              @default(INFORMATIONAL)
  preferredLanguages ContentLanguage[]

  commonPhrases      String[]
  wordsToAvoid        String[]
  hashtagPreferences  String[]
  contentPillars      String[]
  importantProjects   String[]
  publicAchievements  String[]
  officialPositions   String[]
  frequentTopics      String[]
  /// Short, user-attested facts (e.g. "Widened NH-44 in 2024") distinct
  /// from AI-derived claims — see the VERIFIED/UNVERIFIED/INFERENCE
  /// distinction fact-checking enforces in a later phase.
  approvedFacts       String[]

  constituencyId String?       @unique
  constituency   Constituency? @relation(fields: [constituencyId], references: [id], onDelete: SetNull)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

enum SourcePlatform {
  X
  FACEBOOK
  INSTAGRAM
  RSS
  WEBSITE
  OTHER
}

enum SourceCategory {
  POLITICIAN
  GOVERNMENT
  GOVERNMENT_DEPARTMENT
  ADMINISTRATION
  NEWS
  PUBLIC_ORGANIZATION
  LOCAL_INSTITUTION
  OTHER
}

enum MonitoringFrequency {
  HOURLY
  EVERY_6_HOURS
  DAILY
  WEEKLY
}

/// An approved public source the team monitors for content ideas. Only
/// RSS/WEBSITE sources can actually be fetched right now — X/Facebook/
/// Instagram require official API access this app doesn't have configured
/// yet, and the UI must say so rather than attempt any workaround (no
/// scraping — see /docs or the product guardrails in README).
model ReferenceSource {
  id             String @id @default(uuid())
  organizationId String

  name                String
  platform            SourcePlatform
  category            SourceCategory
  handle              String?
  url                 String
  priority            Int                 @default(3)
  enabled             Boolean             @default(true)
  monitoringFrequency MonitoringFrequency @default(DAILY)

  lastFetchedAt   DateTime?
  lastFetchStatus String?
  lastFetchError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referencePosts ReferencePost[]

  @@index([organizationId])
  @@index([platform])
}

/// One ingested item from a ReferenceSource fetch. Deliberately raw/
/// unprocessed — the Content Radar (a later phase) reads these and scores
/// them into ContentOpportunity rows; this table is just the ingestion log.
model ReferencePost {
  id                String    @id @default(uuid())
  organizationId    String
  referenceSourceId String
  externalId        String
  title             String?
  content           String?
  url               String?
  publishedAt       DateTime?
  fetchedAt         DateTime  @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referenceSource    ReferenceSource     @relation(fields: [referenceSourceId], references: [id], onDelete: Cascade)
  contentOpportunity ContentOpportunity?

  @@unique([referenceSourceId, externalId])
  @@index([organizationId])
  @@index([referenceSourceId])
  @@index([publishedAt])
}

enum DocumentSourceType {
  BIOGRAPHY
  FACT_SHEET
  SPEECH
  PREVIOUS_POST
  PRESS_RELEASE
  POLICY_DOCUMENT
  EVENT_INFO
  OTHER
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

/// Distinct from DocumentStatus (is it *processed*): this tracks whether a
/// human has signed off on the document being safe/appropriate for the AI
/// to draw on. A READY document can still be PENDING approval.
enum DocumentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// An uploaded source document (biography, fact sheet, speech, previous
/// post, press release, policy doc, event info) that gets parsed, chunked,
/// and embedded so content generation can retrieve from it. The extracted
/// text and its provenance (uploadedBy, sourceType) matter for the
/// VERIFIED vs UNVERIFIED distinction fact-checking enforces later.
model KnowledgeDocument {
  id             String @id @default(uuid())
  organizationId String

  title         String
  sourceType    DocumentSourceType @default(OTHER)
  fileName      String
  mimeType      String
  fileSize      Int
  storageKey    String
  extractedText String?

  status          DocumentStatus         @default(PROCESSING)
  approvalStatus  DocumentApprovalStatus @default(PENDING)
  processingError String?

  uploadedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  chunks       KnowledgeChunk[]

  @@index([organizationId])
  @@index([status])
}

/// A retrieval-sized slice of a KnowledgeDocument with its embedding.
/// Embedding similarity is computed in application code (see
/// src/lib/knowledge/search.ts) rather than in Postgres — the pgvector
/// extension isn't provisioned yet; fine at this data volume, worth
/// revisiting once a real corpus is in production.
model KnowledgeChunk {
  id             String @id @default(uuid())
  organizationId String
  documentId     String

  chunkIndex Int
  content    String
  embedding  Float[]

  createdAt DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentId])
}

enum OpportunityStatus {
  NEW
  RESEARCHING
  RESEARCHED
  DRAFTED
  DISMISSED
}

/// A scored content idea, surfaced from a ReferencePost by the (rule-based,
/// not AI-guessed) scoring engine in src/lib/radar/score.ts. Scores are
/// computed from real signals — post recency, keyword overlap with the
/// politician's content pillars/constituency, source category/priority —
/// not an LLM's opinion, so they're explainable and reproducible.
model ContentOpportunity {
  id             String  @id @default(uuid())
  organizationId String
  referencePostId String? @unique

  topic             String
  summary           String
  suggestedPlatform String
  suggestedFormat   String

  relevanceScore      Int
  freshnessScore      Int
  localRelevanceScore Int
  publicInterestScore Int
  contentFitScore     Int
  opportunityScore    Int
  reasoning           String

  status OpportunityStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referencePost  ReferencePost?  @relation(fields: [referencePostId], references: [id], onDelete: SetNull)
  researchReport ResearchReport?
  drafts         Draft[]

  @@index([organizationId])
  @@index([status])
  @@index([opportunityScore])
}

/// How a claim's provenance is labeled — the app must never present an
/// AI_INFERENCE or UNVERIFIED item as if it were VERIFIED. See
/// src/lib/research/agent.ts, the only place these get assigned.
enum FactStatus {
  VERIFIED
  USER_PROVIDED
  AI_INFERENCE
  UNVERIFIED
}

/// Output of the Research Agent for one topic. Facts/sources are stored as
/// JSON (an ordered list of { statement, status, source }) rather than
/// normalized tables — they're always read as a whole report, never
/// queried individually, so a join model would add cost without adding
/// capability at this stage.
model ResearchReport {
  id             String  @id @default(uuid())
  organizationId String
  contentOpportunityId String? @unique

  topic      String
  summary    String
  confidence Int
  facts      Json
  sources    Json

  createdById String?

  createdAt DateTime @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy           User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  contentOpportunity  ContentOpportunity? @relation(fields: [contentOpportunityId], references: [id], onDelete: SetNull)
  draft               Draft?

  @@index([organizationId])
}

enum Platform {
  X
  FACEBOOK
  INSTAGRAM
}

/// Mirrors the workflow in the product spec: AI prepares, fact-check runs,
/// a human reviews, only then can it be scheduled/published. No code path
/// may move a Draft to PUBLISHED without passing through APPROVED first —
/// see requireOrganizationAccess(..., "APPROVER") in the approve action.
enum DraftStatus {
  DRAFT
  FACT_CHECK
  NEEDS_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
  FAILED
}

model Draft {
  id                   String  @id @default(uuid())
  organizationId       String
  researchReportId     String? @unique
  contentOpportunityId String?

  platform Platform
  format   String
  language ContentLanguage
  tone     Tone
  body     String
  hashtags String[]
  cta      String?

  status         DraftStatus @default(DRAFT)
  rejectionReason String?
  /// Set when status transitions to SCHEDULED. A publish attempt before
  /// this time is rejected — see publishDraft() in src/lib/social/publish.ts.
  scheduledAt    DateTime?

  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  rejectedById String?
  rejectedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  researchReport      ResearchReport?     @relation(fields: [researchReportId], references: [id], onDelete: SetNull)
  contentOpportunity  ContentOpportunity? @relation(fields: [contentOpportunityId], references: [id], onDelete: SetNull)
  createdBy    User? @relation("DraftCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   User? @relation("DraftApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy   User? @relation("DraftRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)

  revisions  DraftRevision[]
  factChecks FactCheck[]
  socialPost SocialPost?

  @@index([organizationId])
  @@index([status])
  @@index([scheduledAt])
}

/// Every AI or human modification to a draft's body creates one of these —
/// nothing overwrites draft.body without leaving a trail. See the Content
/// Editor (src/app/(dashboard)/drafts/[draftId]).
model DraftRevision {
  id             String @id @default(uuid())
  organizationId String
  draftId        String

  body          String
  changeType    String
  changeSummary String?

  createdById String?
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  draft        Draft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([draftId])
}

enum FactCheckStatus {
  VERIFIED
  PARTIALLY_VERIFIED
  UNVERIFIED
  CONFLICTING
}

/// One claim extracted from a Draft's body, checked against its linked
/// ResearchReport's facts. A draft with any UNVERIFIED/CONFLICTING claim
/// must show a visible warning before approval — see the Content Editor
/// and /approvals list.
model FactCheck {
  id             String @id @default(uuid())
  organizationId String
  draftId        String

  claim       String
  status      FactCheckStatus
  explanation String
  source      String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  draft        Draft         @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([draftId])
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

/// Uploaded photos/videos the team can attach to drafts. Served only
/// through /api/media/[assetId] (checks org membership first) — never
/// through a public /public path, same reasoning as KnowledgeDocument
/// storage. See src/lib/storage.
model MediaAsset {
  id             String @id @default(uuid())
  organizationId String

  fileName   String
  mimeType   String
  fileSize   Int
  storageKey String
  mediaType  MediaType
  tags       String[]
  altText    String?

  uploadedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([mediaType])
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  ERROR
  DISCONNECTED
}

/// One connected platform account per Organization+Platform (MVP scope —
/// a real agency managing multiple accounts per platform is a future
/// enhancement, not needed for a single politician's office). Token is
/// encrypted at rest with ENCRYPTION_KEY — see src/lib/social/crypto.ts.
model SocialAccount {
  id             String @id @default(uuid())
  organizationId String
  platform       Platform

  accountName        String
  externalAccountId  String
  accessTokenEncrypted String

  status   SocialAccountStatus @default(CONNECTED)
  lastError String?

  connectedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User?        @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  socialPosts  SocialPost[]

  @@unique([organizationId, platform])
  @@index([organizationId])
}

enum SocialPostStatus {
  PENDING
  PUBLISHED
  FAILED
}

/// The result of actually publishing one Draft. Idempotent by design —
/// see publishDraft() in src/lib/social/publish.ts, which checks for an
/// existing SocialPost before calling the provider so a retry (or a
/// double cron tick) can never double-post.
model SocialPost {
  id             String @id @default(uuid())
  organizationId String
  draftId        String @unique
  socialAccountId String

  platform        Platform
  platformPostId  String?
  platformUrl     String?
  status          SocialPostStatus @default(PENDING)
  publishedAt     DateTime?
  errorMessage    String?
  responseMetadata Json?

  /// Last analytics snapshot fetched from the platform — see
  /// refreshPostAnalytics() in src/lib/analytics/service.ts. Null fields
  /// mean not yet fetched or the platform doesn't expose that metric.
  impressions        Int?
  likes              Int?
  comments           Int?
  shares             Int?
  analyticsUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  draft         Draft         @relation(fields: [draftId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([socialAccountId])
}
